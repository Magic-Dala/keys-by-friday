# Gemini / Google ADK local auth.
# API-key mode: leave GOOGLE_GENAI_USE_VERTEXAI=FALSE and set one key below.
# Vertex AI mode: set GOOGLE_GENAI_USE_VERTEXAI=TRUE, leave both keys empty,
# and set GOOGLE_CLOUD_PROJECT plus GOOGLE_CLOUD_LOCATION below.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Listing provider: mock (default, no external credentials) or realtyapi.
LISTING_PROVIDER=mock
REALTYAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
AGENT_MODE=adk
FRONTEND_ORIGIN=http://localhost:3000

# Browser identity. Use "disabled" for simple local work or "firebase" to
# require a verified Firebase ID token on POST /api/chat and POST /api/route.
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=

# Backend runtime settings.
APP_ENV=local
AGENT_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Production readiness requires APP_ENV=production with AGENT_MODE=adk,
# LISTING_PROVIDER=realtyapi, and the matching Gemini/RealtyAPI credentials.

# Vertex AI uses this project and location. Cloud Run supplies the project ID,
# but setting both values explicitly makes local and deployed behavior clear.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
