# Gemini / Google ADK local auth. Set either key; GOOGLE_API_KEY is preferred.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Ordered model fallback. The next model is tried only for quota/model/service failures.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# Listing provider: mock (default, no external credentials) or realtyapi.
LISTING_PROVIDER=mock
REALTYAPI_API_KEY=
AGENT_MODE=adk
FRONTEND_ORIGIN=http://localhost:3000
