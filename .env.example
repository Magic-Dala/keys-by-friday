# Gemini / Google ADK local auth. Set either key; GOOGLE_API_KEY is preferred.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Use Gemini 3.7 Flash for the pre-tool pass that interprets broad searches/refinements.
GEMINI_SEARCH_MODEL=gemini-3.7-flash

# Ordered model fallback. The next model is tried only for quota/model/service failures.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# Listing provider: mock (default, no external credentials) or realtyapi.
LISTING_PROVIDER=mock
REALTYAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
AGENT_MODE=adk
FRONTEND_ORIGIN=http://localhost:3000

# Browser identity. Use "disabled" for simple local work or "firebase" to
# require a verified Firebase ID token on POST /api/chat.
AUTH_MODE=disabled
FIREBASE_PROJECT_ID=

# Backend runtime settings.
APP_ENV=local
AGENT_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Production readiness requires APP_ENV=production with AGENT_MODE=adk,
# LISTING_PROVIDER=realtyapi, and the matching Gemini/RealtyAPI credentials.

# Set by Cloud Run automatically when deployed to Google Cloud.
GOOGLE_CLOUD_PROJECT=
